# ==============================================================================
# Environment Configuration Example for Songkhla Old Town Assistant
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# LINE Messaging API Credentials (From LINE Developers Console)
LINE_CHANNEL_SECRET=your_line_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# Cloud API LLM (Groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Local LLM (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_LOCAL_LLM=qwen2.5:7b
COMPARISON_LOCAL_LLM=llama3.2:3b

# Dense Vector Embedding Model
EMBEDDING_MODEL_NAME=kornwtp/ConGen-model-wangchanberta

# Knowledge Graph (Neo4j - Optional / In-Memory NetworkX default)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password1234

# Server & Static Hosting
PORT=5000
BASE_IMAGE_URL=http://localhost:5000/static/images
